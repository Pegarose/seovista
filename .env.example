# Public environment variables (browser-exposable only)
NEXT_PUBLIC_SITE_URL=https://seovista.com
NEXT_PUBLIC_ANALYTICS_ID=

# Server-only environment variables (must never reach browser bundles)
DATABASE_URL=postgresql://seovista:seovista@localhost:8543/seovista
REDIS_URL=redis://localhost:8637/0

GSEO_API_URL="http://localhost:3001/api/v1"
GSEO_API_KEY="gseo_admin_secret_token"

NEXTG_API_URL=http://localhost:3101
NEXTG_API_TOKEN=

DATAFORSEO_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

REPORT_SIGNING_SECRET=

CREW_AGENCY_API_URL=
CREW_AGENCY_API_KEY=

AUDIT_DAILY_COST_LIMIT=
AUDIT_PER_IP_RATE_LIMIT=

# Phase A — Scoring Trust Foundation
BROWSERACT_CACHE_TTL_HOURS=24
BROWSERACT_DAILY_CREDIT_LIMIT=4000
# Browseract render integration (worker fetcher); API_URL defaults to https://api.browseract.com/v2
BROWSERACT_API_KEY=
BROWSERACT_WORKFLOW_ID=
BROWSERACT_API_URL=

# Background worker queues (BullMQ). Queue names default to schema_audit_jobs /
# ai_crawler_audit_jobs / keyword_rank_jobs / crew_report_jobs; concurrency
# defaults to 3 per worker.
SCHEMA_QUEUE_NAME=
AI_CRAWLER_QUEUE_NAME=
KEYWORD_RANK_QUEUE_NAME=
CREW_REPORT_QUEUE_NAME=
SCHEMA_WORKER_CONCURRENCY=
AI_CRAWLER_WORKER_CONCURRENCY=
KEYWORD_RANK_WORKER_CONCURRENCY=
GEO_WORKER_CONCURRENCY=
CREW_REPORT_WORKER_CONCURRENCY=
# Per-IP rate limit for the email-gated AI strategy report action (own Redis
# bucket, separate from the audit rate limit). Defaults to 5 when unset.
CREW_REPORT_PER_IP_RATE_LIMIT=
# SearXNG endpoint for the keyword rank checker worker (http/https). When unset,
# the worker falls back to a deterministic mock provider (no live search traffic).
#
# Deployment shapes:
#   - Local dev, no SearXNG: leave unset (mock) or run
#     `docker compose --profile searxng up -d` and set http://127.0.0.1:8088
#   - Production (worker deployed in the same Coolify project as SearXNG):
#     use the Coolify internal service hostname, e.g.
#     http://<searxng-service-name>:8080 — it resolves only inside the
#     Coolify Docker network, never from a developer machine.
#   - Local dev against the hosted instance: use the PUBLIC routed URL of the
#     SearXNG service (its Coolify domain), NOT the internal hostname.
# A path prefix is preserved (https://host/searxng → /searxng/search).
SEARXNG_BASE_URL=

# Tier B B1 — Recurring keyword rank tracker
# Max active tracking targets per email session. Default 5.
TRACKER_MAX_TARGETS_PER_EMAIL=
# Per-IP rate limit for creating tracking targets (per hour). Default 3.
TRACKER_PER_IP_RATE_LIMIT=
# Delay between SearXNG queries in the daily batch scan (ms). Default 2000.
TRACKER_SCAN_DELAY_MS=
# BullMQ queue name for the tracker scan batch job. Default tracker_scan_jobs.
TRACKER_SCAN_QUEUE_NAME=
# Cron pattern for the daily repeatable batch job. Default '0 3 * * *' (daily 03:00 UTC).
TRACKER_SCAN_CRON=
